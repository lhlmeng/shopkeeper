# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8011
LOG_LEVEL=INFO

# Model cache
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_CACHE=.cache/modelscope
HF_HOME=.cache/huggingface
MD_ROOT_DIR=knowledge/temp_data

# LLM and VLM
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_API_BASE=https://api.openai.com/v1
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_DEFAULT_TEMPERATURE=0
VL_MODEL=gpt-4o-mini
ITEM_MODEL=gpt-4o-mini

# Embedding and reranker
BGE_M3_PATH=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=false
BGE_RERANKER_LARGE=BAAI/bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=false
EMBEDDING_DIM=1024

# MinerU
MINERU_API_TOKEN=replace-with-your-mineru-token
MINERU_BASE_URL=https://your-mineru-api.example.com

# Milvus
MILVUS_URL=http://localhost:19530
CHUNKS_COLLECTION=chunks
ITEM_NAME_COLLECTION=item_name
ENTITY_NAME_COLLECTION=entity_name
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.3

# MongoDB
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=shopkeeper

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=shopkeeper

# Redis
REDIS_URL=redis://localhost:6379/0

# RAG and Agent tuning
MAX_CONTEXT_CHARS=12000
RERANK_MAX_TOP_K=10
RERANK_MIN_TOP_K=3
RERANK_GAP_RATIO=0.25
RERANK_GAP_ABS=0.08
RRF_K=60
RRF_MAX_RESULTS=10
EMBEDDING_SEARCH_LIMIT=5
HYDE_SEARCH_LIMIT=5
ITEM_NAME_HIGH_CONFIDENCE=0.75
ITEM_NAME_MID_CONFIDENCE=0.45
ITEM_NAME_SCORE_GAP=0.08
ITEM_NAME_MAX_OPTIONS=3
ITEM_NAME_DENSE_WEIGHT=0.5
ITEM_NAME_SPARSE_WEIGHT=0.5

# MCP
MCP_DASHSCOPE_BASE_URL=https://your-dashscope-mcp.example.com
